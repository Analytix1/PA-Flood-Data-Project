# Copy this file to ".env" and set the two paths to your local folders.
# The notebooks read these via os.environ.get(...). You can either set them
# as system/session environment variables, or just edit the fallback strings
# in the first cell of each notebook.
#
# .env itself is gitignored, so your real paths are never committed.

# Folder containing "PA Flood Risk GIS.gdb" and the result outputs
PA_FLOOD_PROJECT=C:\path\to\PA Flood Risk GIS

# Folder containing the NHDPlus gdb, the DEM (watershed_dem\dem.tif), and OSM_PA
PA_FLOOD_DATA=C:\path\to\Final Project\Data
